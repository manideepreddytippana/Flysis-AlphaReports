# db url
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/flysis_db

# sarvam ai api
SARVAM_API_KEY=your_sarvam_api_key_here

# Embedding model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Upload directory
UPLOADS_DIR=./uploads
MAX_FILE_SIZE_MB=50
OCR_ENABLED=True

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS Origins
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
